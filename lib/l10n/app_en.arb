  "tutGoalTitle": "Win 2 of 3 lines",
  "@tutGoalTitle": {},
  "tutGoalBody": "Each side has three lines of five slots. Matching lines face off with poker hands — win two of the three and you win the match.",
  "@tutGoalBody": {},
  "tutPlaceTitle": "Place a card",
  "@tutPlaceTitle": {},
  "tutPlaceBody": "On your turn, put one card from your hand into one of your lines. Position within a line means nothing — the only choice is which line.",
  "@tutPlaceBody": {},
  "tutAttackTitle": "Take a card",
  "@tutAttackTitle": {},
  "tutAttackBody": "Only your starting cards carry an attack mark. Use one to take an opponent card of the same number into an empty slot of yours. What you take becomes a shield — it can't be taken back.",
  "@tutAttackBody": {},
  "tutJokerTitle": "Only two jokers",
  "@tutJokerTitle": {},
  "tutJokerBody": "Name any number and suit when you place one, and take any opponent card you like. It's the only thing that breaks a shield, so it's worth saving.",
  "@tutJokerBody": {},
  "tutFoldTitle": "Folding isn't surrender",
  "@tutFoldTitle": {},
  "tutFoldBody": "It means \"I'm done placing.\" Use it when another card would only make your lines worse. You can still win with the lines you already built.",
  "@tutFoldBody": {},
  "rulesGoalTitle": "Goal",
  "@rulesGoalTitle": {},
  "rulesGoalBody": "Win two of the three lines. If neither side takes two (say 1 win, 1 draw, 1 loss), the higher total across all three lines wins.",
  "@rulesGoalBody": {},
  "rulesDeckTitle": "The 58-card deck",
  "@rulesDeckTitle": {},
  "rulesDeckBody": "Fourteen ranks (1–10, J, Q, K, A) in four suits, plus two jokers. Every rank appears exactly four times.",
  "@rulesDeckBody": {},
  "rulesDeckNote": "The \"1\" card and the ace are two different cards — this is not a standard deck. An ace is always worth 14, but it can also count as 0 inside a straight.",
  "@rulesDeckNote": {},
  "rulesSetupTitle": "Setup",
  "@rulesSetupTitle": {},
  "rulesSetupBody": "Each player draws six cards, all marked as attackers. Both reveal one card at the same time; the higher card goes first, ties broken by suit (spades > hearts > diamonds > clubs). Revealed cards are discarded.",
  "@rulesSetupBody": {},
  "rulesTurnTitle": "Your turn",
  "@rulesTurnTitle": {},
  "rulesTurnBody": "At the start of your turn, draw back up to five cards. Cards drawn this way carry no attack mark. Then do exactly one thing: place, attack, or fold.",
  "@rulesTurnBody": {},
  "rulesAttackTitle": "Attacking",
  "@rulesAttackTitle": {},
  "rulesAttackBody": "All three must hold: (1) the card has an attack mark or is a joker, (2) the target has the same number (a joker ignores this), and (3) you have an empty slot.",
  "@rulesAttackBody": {},
  "rulesAttackBonus": "What you take lands in your empty slot as a shield, and the attacking card is discarded. A successful attack also earns one extra placement that turn — but not a second attack.",
  "@rulesAttackBonus": {},
  "rulesShieldTitle": "Shields",
  "@rulesShieldTitle": {},
  "rulesShieldBody": "A shield can't be taken by a normal attacker — only a joker breaks it. It scores exactly like any other card; being safe is its only extra property.",
  "@rulesShieldBody": {},
  "rulesJokerTitle": "Jokers",
  "@rulesJokerTitle": {},
  "rulesJokerBody": "Two in the whole deck. You name its number and suit when placing it, and that's final. It can take any opponent card including shields, and a placed joker can only be taken by another joker.",
  "@rulesJokerBody": {},
  "rulesHandsTitle": "Hand ranks",
  "@rulesHandsTitle": {},
  "rulesHandsNote": "Five of a kind, straight flush, four of a kind, full house, flush and straight only count on a full line of five. A partial line can reach three of a kind at best.",
  "@rulesHandsNote": {},
  "rulesScoreTitle": "Scoring",
  "@rulesScoreTitle": {},
  "rulesScoreBody": "Compare hand rank first; if they tie, compare point value. Point value = the sum of all numbers, plus (count − 1) × the number for each repeated group. Suits never affect the score.",
  "@rulesScoreBody": {},
  "rulesEndTitle": "Ending the game",
  "@rulesEndTitle": {},
  "rulesEndBody": "The game ends when both players fold, all thirty slots are full, or nobody can make a legal move. An empty deck doesn't end it — you keep playing while cards remain in hand. Lines can finish incomplete.",
  "@rulesEndBody": {},
  "rulesTokenTitle": "Tokens (optional)",
  "@rulesTokenTitle": {},
  "rulesTokenBody": "If you own tokens you can spend them on your turn. A shield token turns one of your cards into a shield; an attack token marks one card in your hand as an attacker. Neither uses up your turn, and you may spend at most one of each per match.",
  "@rulesTokenBody": {}
}

  "tutGoalTitle": "Win two of three",
  "@tutGoalTitle": {},
  "tutGoalBody": "Matching lines face off with poker hands. Win two of the three lines and the match is yours.",
  "@tutGoalBody": {},
  "tutPlaceTitle": "Play them face down",
  "@tutPlaceTitle": {},
  "tutPlaceBody": "Each round you pick three cards from hand and place them on your lines — face down. Your opponent sees where, never what.",
  "@tutPlaceBody": {},
  "rulesGoalTitle": "Goal",
  "@rulesGoalTitle": {},
  "rulesGoalBody": "Both sides fill three lines of five cards. Matching lines face off with poker hands — win two of the three lines and the match is yours. If the line count ties, the higher total score wins.",
  "@rulesGoalBody": {},
  "rulesDeckTitle": "The deck",
  "@rulesDeckTitle": {},
  "rulesDeckBody": "A standard 52-card deck plus two jokers — 2 through 10, J, Q, K, A in four suits. Numbers count at face value: J=11, Q=12, K=13, A=14.",
  "@rulesDeckBody": {},
  "rulesDeckNote": "An ace may also count as 1, but only inside a straight (A-2-3-4-5). Suit order is ♠ > ♥ > ◆ > ♣.",
  "@rulesDeckNote": {},
  "rulesSetupTitle": "Setup",
  "@rulesSetupTitle": {},
  "rulesSetupBody": "You start with six cards in hand and draw three more each round. Your hand always holds more than you can play — choosing which three to commit is the decision of every round.",
  "@rulesSetupBody": {},
  "rulesHandsTitle": "Hand ranks",
  "@rulesHandsTitle": {},
  "rulesHandsNote": "Straight flush, four of a kind, full house, flush and straight only count on a full line of five. A partial line can reach three of a kind at best.",
  "@rulesHandsNote": {},
  "rulesScoreTitle": "Scoring",
  "@rulesScoreTitle": {},
  "rulesScoreBody": "Hands of the same rank are broken by total value: the sum of the card values plus a matching-group bonus ((count - 1) x value). Example: A A = 28 + 14 = 42.",
  "@rulesScoreBody": {},
  "rulesEndTitle": "Ending the match",
  "@rulesEndTitle": {},
  "rulesEndBody": "After the fifth round every card still hidden is turned over in a final reveal, then all three lines are judged on full information. Two lines wins the match; if the line count ties, the higher total score wins.",
  "@rulesEndBody": {},
